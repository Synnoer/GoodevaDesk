# Application Config
PORT=3000
NODE_ENV=development

# Database Config (PostgreSQL + Prisma)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=goodevadesk
DB_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/goodevadesk?schema=public"

# Redis Config (Caching & Rate-Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# LLM Config (Gemini & Groq)
# Options: 'gemini' | 'groq'
LLM_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq API
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Tenant API Rate Limiting
TENANT_API_RATE_LIMIT_MAX=10
TENANT_API_RATE_LIMIT_WINDOW=60

# Tenant LLM Token Rate Limiting
TENANT_LLM_TOKEN_LIMIT_MAX=2000
TENANT_LLM_TOKEN_LIMIT_WINDOW=600

# LLM Classification Cache
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=604800
