# Application Config
PORT=3000
NODE_ENV=development

# Database Config (PostgreSQL + Prisma)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=goodevadesk
DB_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/goodevadesk?schema=public"

# Redis Config (Caching & Rate-Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# LLM Config (Gemini & Groq)
# Options: 'gemini' | 'groq'
LLM_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq API
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
